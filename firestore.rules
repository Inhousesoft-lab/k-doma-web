rules_version = '2';

// K-Doma Firestore 보안 규칙
// - 가구(households/{hid}) 문서 id = 만든 사람의 uid. 구성원(memberIds)만 가구 데이터(냉장고·장바구니·요리 기록)를 읽고 쓴다.
// - 가구 합류 기능 전까지 구성원 변경(update)은 막는다.
// - 찜(users/{uid}/favorites)은 계정별이라 본인만 읽고 쓴다.
// - 시각(updatedAt·createdAt 등)은 앱이 serverTimestamp() 로만 쓴다 → 규칙에서 request.time 과 같은지 확인한다.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMember(hid) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/households/$(hid)).data.memberIds;
    }

    function validIngredient(d) {
      return d.keys().hasOnly(['name', 'zone', 'status', 'imageKey', 'updatedAt', 'updatedBy'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 40
        && d.zone in ['SEASONING', 'FRIDGE']
        && d.status in ['HAVE', 'LOW', 'NONE']
        && (!('imageKey' in d) || d.imageKey == null || d.imageKey is string)
        && d.updatedBy == request.auth.uid
        && d.updatedAt == request.time;
    }

    function validCartItem(d) {
      return d.keys().hasOnly(['name', 'zone', 'isUrgent', 'checked', 'updatedAt', 'updatedBy'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 40
        && d.zone in ['SEASONING', 'FRIDGE']
        && d.isUrgent is bool
        && d.checked is bool
        && d.updatedBy == request.auth.uid
        && d.updatedAt == request.time;
    }

    // 요리 기록 만들기 (KD-57, KD-61). 문서 id = 날짜_요리id, 요리 예정으로만 만든다
    function validPlanCreate(d, planId) {
      return d.keys().hasOnly(['date', 'recipeId', 'recipeName', 'photoUrl', 'status', 'inventoryUpdated',
          'plannedBy', 'plannedAt', 'updatedBy', 'updatedAt'])
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.recipeId is string && d.recipeId.size() > 0 && d.recipeId.size() <= 64
        && planId == d.date + '_' + d.recipeId
        && d.recipeName is string && d.recipeName.size() > 0 && d.recipeName.size() <= 80
        && (d.photoUrl == null || (d.photoUrl is string && d.photoUrl.size() <= 2048))
        && d.status == 'PLANNED'
        && d.inventoryUpdated == false
        && d.plannedBy == request.auth.uid && d.plannedAt == request.time
        && d.updatedBy == request.auth.uid && d.updatedAt == request.time;
    }

    // 요리 기록 바꾸기: 아래 두 가지만 된다. 요리·날짜는 바꿀 수 없다
    // 1. [요리 완료] PLANNED → COOKED
    // 2. 재고 반영 false → true (한 번만. 되돌리기·다시 수정 없음)
    function validPlanUpdate() {
      let before = resource.data;
      let after = request.resource.data;
      let changed = after.diff(before).affectedKeys();
      return after.updatedBy == request.auth.uid && after.updatedAt == request.time
        && (
          (before.status == 'PLANNED' && after.status == 'COOKED'
            && changed.hasOnly(['status', 'cookedBy', 'cookedAt', 'updatedBy', 'updatedAt'])
            && after.cookedBy == request.auth.uid && after.cookedAt == request.time)
          ||
          (before.status == 'COOKED' && before.inventoryUpdated == false && after.inventoryUpdated == true
            && changed.hasOnly(['inventoryUpdated', 'inventoryUpdatedBy', 'inventoryUpdatedAt', 'updatedBy', 'updatedAt'])
            && after.inventoryUpdatedBy == request.auth.uid && after.inventoryUpdatedAt == request.time)
        );
    }

    match /households/{hid} {
      allow read: if signedIn() && (hid == request.auth.uid || request.auth.uid in resource.data.memberIds);
      allow create: if signedIn() && hid == request.auth.uid
        && request.resource.data.keys().hasOnly(['name', 'memberIds', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;

      match /fridge/{ingredientId} {
        allow read, delete: if isMember(hid);
        allow create, update: if isMember(hid) && validIngredient(request.resource.data);
      }

      // 장바구니 (가구 공유)
      match /cart/{itemId} {
        allow read, delete: if isMember(hid);
        allow create, update: if isMember(hid) && validCartItem(request.resource.data);
      }

      // 요리 기록 (가구 공유, KD-57). 이미 있는 문서를 다시 만들면 update 라서 막힌다 (중복 막기, KD-61)
      // 하루 10개 제한은 앱에서만 확인한다
      match /plans/{planId} {
        allow read, delete: if isMember(hid);
        allow create: if isMember(hid) && validPlanCreate(request.resource.data, planId);
        allow update: if isMember(hid) && validPlanUpdate();
      }
    }

    // 찜 (계정별, KD-27). 문서 id = 요리 id. 본인만 읽고 쓴다.
    // 이미 찜한 요리를 다시 저장(setDoc)하면 update 라서 update 도 허용한다.
    match /users/{uid}/favorites/{recipeId} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.createdAt == request.time
        && recipeId.size() > 0 && recipeId.size() <= 64;
    }
  }
}
